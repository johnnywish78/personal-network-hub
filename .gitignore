# --- Secrets (NEVER commit these) ---
.env
*.env
!*.env.example
~/.jpnh/
.jpnh/
**/secrets.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Track production build source scripts
!desktop/build/
!desktop/build/backend_entry.py
!desktop/build/scripts/
!desktop/build/scripts/build-backend.mjs
!desktop/build/scripts/build-network-checker.mjs
.pytest_cache/

# --- Node / Electron ---
node_modules/
desktop/node_modules/
dist-electron/

# --- Local data ---
*.log
.DS_Store
# Per-machine Update Manager metadata (written into component trees)
.jpnh-update.json
.jpnh-pending-apply.json

# --- Build artifacts ---
resources/backend/
resources/network-checker/
third_party/network-checker/build/
third_party/network-checker/.dart_tool/
third_party/network-checker/.flutter-plugins*

.idea/
third_party/network-checker/android/app/src/main/jniLibs/arm64-v8a/libxray.so

# Local development backups
*.before-*
